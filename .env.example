# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings -> Your apps -> Web app). These are public identifiers for
# the web app, but keep them out of git anyway. Never put API keys for other
# services or any private secret in this file.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# reCAPTCHA v3 site key for App Check (Firebase console -> App Check -> reCAPTCHA v3).
# In local dev the App Check debug token is used instead, so this can stay empty.
VITE_RECAPTCHA_SITE_KEY=
# Free Gemini Developer API key for the cloud fallback (IN_CLOUD).
# Get one at Google AI Studio (https://aistudio.google.com) and paste it here.
# Without it, triage only works on-device (Gemini Nano) and deep analysis is unavailable.
VITE_GEMINI_API_KEY=
